{
  "name": "webpack-template",
  "version": "1.0.0",
  "private": true,
  "description": "Starter for vanilla JavaScript projects: Webpack 5 with separate dev and prod configs, CSS, images and fonts.",
  "type": "module",
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayssarrsilva/webpack-template.git"
  },
  "author": "Rayssa Roberta <rayssarrsilva1@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=22.15"
  }
}
